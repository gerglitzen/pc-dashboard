# Copy to .env (never commit .env) and fill in. Leave the values empty to turn the Clockify integration off.
# API key: Clockify → Profile settings → API → Generate
CLOCKIFY_API_KEY=
# Your Clockify user id: the "id" field of GET https://api.clockify.me/api/v1/user
CLOCKIFY_USER_ID=
# Notion: an integration token with access to the Tasks database, and your Notion user id. Leave empty to turn the Notion sync off.
NOTION_API_KEY=
NOTION_USER_ID=
